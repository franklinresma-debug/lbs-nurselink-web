}

.nl713-login-field input {
  border-color: #c9d5df;
  background: #f8fafc;
  color: #102a43;
}

.nl713-login-field input:hover {
  border-color: #aebfcd;
}

.nl713-login-field input:focus {
  border-color: var(--lbs-blue-dark) !important;
  background: #fff;
  box-shadow: 0 0 0 4px rgba(23, 104, 176, 0.13) !important;
}

.nl713-login-submit {
  background: var(--lbs-blue-dark) !important;
  color: #fff !important;
  box-shadow: 0 8px 20px rgba(23, 104, 176, 0.2);
}

.nl713-login-submit:hover:not(:disabled) {
