/* LBS corporate palette derived from the approved Job Order reference. */
:root {
  --lbs-lime: #9acb24;
  --lbs-lime-dark: #79a517;
  --lbs-lime-soft: #eef7d8;
  --lbs-blue: #377be8;
  --lbs-blue-dark: #1768b0;
  --lbs-orange: #f79331;
  --lbs-orange-dark: #dc7518;
  --lbs-warm-canvas: #f2f5f8;
  --lbs-border: #d7e0e8;
  --lbs-ink: #34404d;
  --lbs-topbar-control-size: 44px;
}

