.nl713-login-shell {
  background: #f3f6f9 !important;
}

.nl713-login-hero {
  background: #0a3852 !important;
}

.nl713-login-hero-media picture {
  position: absolute;
  inset: 0;
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}

.nl713-login-hero-media img {
  position: absolute;
  inset: 0;
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  object-fit: cover !important;
  object-position:
    var(--nl-hero-slide-x-desktop, 72%)
    var(--nl-hero-slide-y-desktop, 32%);
  filter: saturate(0.9) contrast(1.04);
}

.nl713-login-hero-media::after {
  background:
    linear-gradient(
      90deg,
      rgba(5, 33, 52, 0.97) 0%,
      rgba(6, 46, 66, 0.88) 38%,
      rgba(7, 64, 78, 0.50) 66%,
      rgba(7, 65, 76, 0.18) 100%
    ),
    linear-gradient(
      180deg,
      rgba(5, 33, 52, 0.08) 42%,
      rgba(5, 33, 52, 0.78) 100%
    ) !important;
}

.nl713-login-hero-content {
  padding: clamp(38px, 4vw, 64px) !important;
}

.nl713-login-hero-content .nurselink-login-logo {
  width: min(420px, 78%);
  height: clamp(64px, 9vw, 108px);
  margin-top: clamp(18px, 4vh, 44px);
  display: flex;
  align-items: center;
}

/* Keep the logo slot in flow so copy, hero height and image crop stay stable.
   The brand itself is one compact overlay shared by every slider image. */
.nl713-login-hero-content .nurselink-login-logo img {
  position: absolute;
  top: 12px;
  left: clamp(22px, 4vw, 64px);
  z-index: 3;
  display: block;
  width: min(220px, 45%);
  max-width: 45%;
  height: auto;
  max-height: 64px;
  padding: 5px 7px;
  border: 1px solid rgba(255, 255, 255, .8);
  border-radius: 10px;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 3px 12px rgba(2, 20, 33, .16);
  object-fit: contain;
  filter: none;
}

@media (max-width: 780px) {
  .nl713-login-hero-content .nurselink-login-logo img {
    top: 8px;
    left: 22px;
    width: min(180px, 45%);
    max-height: 52px;
    padding: 3px 5px;
  }
}

.nl713-login-hero-content .nurselink-login-logo:not([hidden]) + .nl713-login-message {
  margin-top: clamp(22px, 4vh, 42px);
}

.nl713-login-benefit-icon {
  background: #fff !important;
  color: var(--lbs-blue-dark) !important;
  border-color: rgba(255, 255, 255, 0.6) !important;
  box-shadow: inset 0 -3px 0 var(--lbs-orange), 0 8px 24px rgba(2, 22, 36, 0.18);
}

.nl713-login-message {
  margin-top: clamp(58px, 9vh, 96px);
}

.nl713-login-kicker,
.nl713-login-card .nl713-login-card-kicker {
  display: inline-flex;
  align-items: center;
  padding: 6px 16px;
  border-radius: 999px;
  background: #84B728;
  color: #fff !important;
  text-transform: uppercase;
  text-shadow: none;
}

.nl713-login-intro {
  display: flow-root;
}

@media (min-width: 781px) {
  .nl713-login-hero {
    container-type: inline-size;
  }

  .nl713-login-intro {
    /* Reserve the 2:1 slider height, excluding the content's top padding. */
    min-height: calc(50cqw - clamp(38px, 4vw, 64px));
  }
}

.nl713-login-message h1 {
  max-width: 520px;
  color: #fff !important;
  font-size: clamp(44px, 3.4vw, 60px) !important;
  line-height: 1.04 !important;
  letter-spacing: -0.038em;
  text-shadow: 0 2px 22px rgba(2, 20, 33, 0.24);
}

.nl713-login-message > p {
  color: rgba(255, 255, 255, 0.91);
}

.nl713-login-benefits {
  gap: 14px;
  margin-top: 48px;
}

.nl713-login-benefit-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
}

.nl713-login-benefit {
  grid-template-columns: 42px 1fr;
  gap: 12px;
}

.nl713-login-benefit span {
  color: rgba(255, 255, 255, 0.82);
}

.nl713-login-hero-foot {
  border-color: rgba(255, 255, 255, 0.18);
  background: rgba(5, 34, 52, 0.68);
  box-shadow: 0 12px 34px rgba(2, 20, 33, 0.16);
}

.nl713-login-panel {
  border-left: 1px solid #dce4eb;
  background: #f3f6f9 !important;
}

.nl713-login-card {
  position: relative;
  width: min(100%, 520px);
  overflow: hidden;
  border-color: #d8e1e8;
  border-radius: 22px;
  box-shadow: 0 22px 58px rgba(18, 48, 71, 0.12);
}

.nl713-login-card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 4px;
  background: linear-gradient(
    90deg,
    var(--lbs-blue-dark) 0 72%,
    var(--lbs-lime) 72% 90%,
    var(--lbs-orange) 90% 100%
  );
}

.nl713-login-card h2 {
  color: #102a43 !important;
}

.nl713-login-card-intro {
  color: #60758a;
}

.nl713-login-card-kicker,
.nl713-login-forgot a,
.nl713-login-register a {
