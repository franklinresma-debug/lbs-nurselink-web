}

.nl713-login-trust-item span {
  color: #687d91;
}

.nl713-login-admin {
  border-color: #c8d4de !important;
  background: #f8fafc;
  color: #29445d !important;
}

.nl713-login-admin:hover {
  border-color: var(--lbs-orange) !important;
  background: #fff9f2;
  color: #b85e0c !important;
}

.nl713-login-forgot a:focus-visible,
.nl713-login-register a:focus-visible,
.nl713-login-submit:focus-visible,
.nl713-login-admin:focus-visible {
  outline: 3px solid rgba(247, 147, 49, 0.55);
  outline-offset: 3px;
}

